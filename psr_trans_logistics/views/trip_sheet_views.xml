<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_psr_trip_sheet_tree" model="ir.ui.view">
        <field name="name">psr.trip.sheet.tree</field>
        <field name="model">psr.trip.sheet</field>
        <field name="arch" type="xml">
            <list string="Trip Sheets">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin_location"/>
                <field name="destination_location"/>
                <field name="trip_date_start"/>
                <field name="gr_count"/>
                <field name="distance_travelled"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_psr_trip_sheet_form" model="ir.ui.view">
        <field name="name">psr.trip.sheet.form</field>
        <field name="model">psr.trip.sheet</field>
        <field name="arch" type="xml">
            <form string="Trip Sheet">
                <header>
                    <button name="action_start_trip" string="Start Trip" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete_trip" string="Complete Trip" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Vehicle / Driver">
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group string="Route">
                            <field name="origin_location"/>
                            <field name="destination_location"/>
                            <field name="trip_date_start"/>
                            <field name="trip_date_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Odometer">
                            <field name="odometer_start"/>
                            <field name="odometer_end"/>
                            <field name="distance_travelled"/>
                        </group>
                        <group string="Fuel">
                            <field name="currency_id" invisible="1"/>
                            <field name="fuel_quantity"/>
                            <field name="fuel_cost"/>
                            <field name="fuel_log_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consolidated Goods Receipts">
                            <field name="gr_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="booking_location"/>
                                    <field name="consignor_id"/>
                                    <field name="consignee_id"/>
                                    <field name="package_count"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_psr_trip_sheet" model="ir.actions.act_window">
        <field name="name">Trip Sheets</field>
        <field name="res_model">psr.trip.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Trip Sheet</p>
        </field>
    </record>
</odoo>
