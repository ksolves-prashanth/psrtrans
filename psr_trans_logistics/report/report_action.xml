<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PAPER FORMAT: A4 Portrait, minimal margins
         (three copies must fit on a single page, so margins are tight)
         ============================================================ -->
    <record id="paperformat_psr_goods_receipt" model="report.paperformat">
        <field name="name">PSR Goods Receipt A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- ============================================================
         REPORT ACTION
         ============================================================ -->
    <record id="action_report_psr_goods_receipt" model="ir.actions.report">
        <field name="name">PSR Goods Receipt</field>
        <field name="model">psr.goods.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">psr_trans_logistics.report_psr_goods_receipt</field>
        <field name="report_file">psr_trans_logistics.report_psr_goods_receipt</field>
        <field name="print_report_name">'PSR Goods Receipt - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_psr_goods_receipt"/>
        <field name="binding_model_id" ref="model_psr_goods_receipt"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
