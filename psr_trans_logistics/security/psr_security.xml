<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_psr_transport" model="ir.module.category">
            <field name="name">PSR Transport Logistics</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_psr_transport" model="res.groups.privilege">
            <field name="name">Transport Logistics</field>
            <field name="category_id" ref="module_category_psr_transport"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_psr_user" model="res.groups">
            <field name="name">Transport User</field>
            <field name="privilege_id" ref="privilege_psr_transport"/>
        </record>

        <record id="group_psr_manager" model="res.groups">
            <field name="name">Transport Manager</field>
            <field name="privilege_id" ref="privilege_psr_transport"/>
            <field name="implied_ids" eval="[(4, ref('group_psr_user'))]"/>
        </record>
    </data>
</odoo>